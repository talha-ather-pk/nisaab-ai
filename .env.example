# =============================================================================
# Nisaab AI environment. Copy to .env (for docker compose) and/or backend/.env
# (for running uvicorn directly), then replace every "change-me" value.
# Never commit the real .env.
# =============================================================================

# --- PostgreSQL (docker compose) ---------------------------------------------
POSTGRES_USER=nisaab
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=nisaab
POSTGRES_PORT=5432

# --- Backend -------------------------------------------------------------------
# Used when running uvicorn directly. Docker compose builds its own from the values above.
DATABASE_URL=postgresql+psycopg://nisaab:change-me-strong-db-password@localhost:5432/nisaab

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-generate-a-64-character-random-secret-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated; "*" is fine for a mobile-only client in development.
CORS_ORIGINS=*
TIMEZONE=Asia/Karachi
ENVIRONMENT=development
API_PORT=8000
WEB_CONCURRENCY=2

# --- AI assistant --------------------------------------------------------------
# auto   = use Claude when ANTHROPIC_API_KEY is set, else the built-in rule engine
# claude = always try Claude (falls back to rules on error)
# rules  = never call an external API
ASSISTANT_PROVIDER=auto
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
